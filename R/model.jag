model {
  # Likelihood
  for (i in 1:n) {
    winner_sets[i] ~ dbin(p[i], n_sets[i])
    logit(p[i]) <- eta[winner_id[i], time[i]] + alpha[winner_id[i], surface[i]] -
                   eta[loser_id[i], time[i]]  - alpha[winner_id[i], surface[i]]
  }

  # Prior on eta and alpha
  for (j in 1:n_player) {
    eta_center[j] <- ifelse(new[j], 0, mu_eta[j])
    eta_spread[j] <- ifelse(new[j], tau[1], tau_eta[j])
    eta[j,1] ~ dnorm(eta_center[j], eta_spread[j])
    for (t in 2:n_time) {
      eta[j, t] ~ dnorm(eta[j, t - 1], tau[2])
    }
    for (k in 1:n_surface) {
      alpha_center[j, k] <- ifelse(new[j], 0, mu_alpha[j, k])
      alpha_spread[j, k] <- ifelse(new[j], tau[3], tau_alpha[j, k])
      alpha[j, k] ~ dnorm(alpha_center[j,k], alpha_spread[j, k])
    }
  }

  # Prior on tau
  for (j in 1:3) {
    tau[j] <- t[j]/rss[j]
    t[j] ~ dchisqr(tdf[j])
  }
}
