model {
  # Likelihood
  for (i in 1:n) {
    winner_sets[i] ~ dbin(p[i], n_sets[i])
    logit(p[i]) <- eta[winner_id[i], time[i]] + alpha[winner_id[i], surface[i]] -
                   eta[loser_id[i], time[i]]  - alpha[loser_id[i], surface[i]] +
                   dispersion[i]
    dispersion[i] ~ dnorm(0, tau[1])
  }

  # Prior on eta and alpha
  for (j in 1:n_player) {
    eta[j, 1] ~ dnorm(eta_mean[j], eta_prec[j])
    for (t in 2:n_time) {
      eta[j, t] ~ dnorm(eta[j, t - 1], tau[2])
    }
    eta_mean[j] ~ dnorm(eta_mean_hyp_m, eta_mean_hyp_p)
    eta_prec[j] <- eta_t[j]/eta_rss
    eta_t[j] ~ dchisqr(eta_tdf)
    for (k in 1:n_surface) {
      alpha[j, k] ~ dnorm(alpha_mean[j, k], alpha_prec[j, k])
      alpha_mean[j, k] ~ dnorm(alpha_mean_hyp_m, alpha_mean_hyp_p)
      alpha_prec[j, k] <- alpha_t[j, k]/alpha_rss
      alpha_t[j, k] ~ dchisqr(alpha_tdf)
    }
  }

  # Prior on tau
  for (j in 1:2) {
    tau[j] <- t[j]/rss[j]
    t[j] ~ dchisqr(tdf[j])
  }
}
