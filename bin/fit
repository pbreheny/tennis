#!/usr/bin/env Rscript
suppressMessages(library(docopt))
"Usage: fit <side> <year> [-h]

--<side>  atp/wta
--<year>  2012/2013/...
-h        Show this help screen" -> doc
opt <- docopt(doc)
side <- opt$side
year <- as.numeric(eval(parse(text=opt$year)))
# side <- "atp"
# year <- 2017

# Import
dat <- import(year, side)
y <- dat$dat$Wsets
ns <- dat$dat$Wsets + dat$dat$Lsets
nm <- nrow(dat$dat)
np <- length(dat$PlayerID)
prior <- make_prior(dat$PlayerID, side, year)

# Fit setup
jags_data <- c(
  with(
    dat,
    list(
      Winner = Winner,
      Loser = Loser,
      Surface = Surface,
      Time = Time,
      T = max(Time),
      y = y,
      ns = ns,
      nm = nm,
      np = np
    )
  ),
  prior
)
monitor <- c("eta", "alpha", "tau")
f <- function(chain) {
  list(
    eta = matrix(rnorm(np * max(dat$Time)), nrow = np),
    alpha = matrix(rnorm(np * 3), nrow = np)
  )
}
inits <- mapply(f, 1:3, SIMPLIFY = FALSE)

# Fit
jags_fit <- run.jags(
  "R/model.jag",
  monitor = monitor,
  data = jags_data,
  inits = inits,
  n.chains = length(inits),
  method = "rjparallel",
  adapt = 500,
  burnin = 500,
  sample = 2000,
  summarise = FALSE
)

# eta: overall skill
eta <- gather_draws(jags_fit, eta[i,j]) |>
  as.data.table() |>
  _[, .(mean = mean(.value), sd = sd(.value)), .(i, j)] |>
  _[, Player := PlayerID[i]] |>
  _[, Time := TimeID[j]]

# Delta <- Eta[,ncol(Eta)]

# alpha: surface effects
alpha <- gather_draws(jags_fit, alpha[i,j]) |>
  as.data.table() |>
  _[, .(mean = mean(.value), sd = sd(.value)), .(i, j)] |>
  _[, Player := PlayerID[i]] |>
  _[, Surface := SurfaceID[j]]

# tau: 
tau <- gather_draws(jags_fit, tau[i]) |>
  as.data.table() |>
  _[, .(mean = mean(.value), sd = sd(.value)), i] |>
  _[, Surface := SurfaceID[i]] |>
  _[, rss := 2 * mean / sd^2] |>
  _[, tdf := rss * mean]

save(Eta, Alpha, Delta, sdEta, sdAlpha, rss, tdf, file=paste0("psm/", side, "/", year, ".RData"))
