#!/usr/bin/env Rscript
suppressMessages(library(docopt))
"Usage: fit <side> <year> [-h]

--<side>  atp/wta
--<year>  2012/2013/...
-h        Show this help screen" -> doc
if (interactive()) {
  side <- "atp"
  year <- 1990
} else {
  opt <- docopt(doc)
  side <- opt$side
  year <- as.numeric(eval(parse(text=opt$year)))
}
devtools::load_all(quiet = TRUE)

# Import
dat <- import(year, side)
player_names <- c(dat$winner_name, dat$loser_name)
player_data <- compose_data(player_names)
player_map <- factor(player_names) |> levels()
time_map <- factor(dat$time) |> levels()
surface_map <- factor(dat$surface) |> levels()
jags_data <- c(
  compose_data(dat[, .(winner_sets, n_sets = winner_sets + loser_sets, surface, time)]),
  list(winner_id = player_data[[1]][1:nrow(dat)]),
  list(loser_id = player_data[[1]][(nrow(dat) + 1):(2 * nrow(dat))]),
  list(n_player = player_data[[2]]),
  make_prior(player_map, side, year)
)

# Fit
monitor <- c("eta", "alpha", "tau")
f <- function(chain) {
  with(jags_data, {
    list(
      eta = rnorm(n_player * n_time) |> matrix(nrow = n_player),
      alpha = rnorm(n_player * 3) |> matrix(nrow = n_player)
    )
  })
}
inits <- mapply(f, 1:3, SIMPLIFY = FALSE)
jags_fit <- run.jags(
  "R/model.jag",
  monitor = monitor,
  data = jags_data,
  inits = inits,
  n.chains = length(inits),
  method = "rjparallel",
  adapt = 500,
  burnin = 500,
  sample = 2000,
  summarise = FALSE
)

# eta: overall skill (by time)
eta <- gather_draws(jags_fit, eta[i,j]) |>
  as.data.table() |>
  _[, .(mean = mean(.value), sd = sd(.value)), .(i, j)] |>
  _[, player := player_map[i]] |>
  _[, time := time_map[j]]

# alpha: surface effects
alpha <- gather_draws(jags_fit, alpha[i,j]) |>
  as.data.table() |>
  _[, .(mean = mean(.value), sd = sd(.value)), .(i, j)] |>
  _[, player := player_map[i]] |>
  _[, surface := surface_map[j]]

# tau: (tdf and rss control prior on tau) precision of
#   eta
#   ar process
#   surface
#   dispersion
tau <- gather_draws(jags_fit, tau[i]) |>
  as.data.table() |>
  _[, .(mean = mean(.value), sd = sd(.value)), i] |>
  _[, rss := 2 * mean / sd^2] |>
  _[, tdf := rss * mean]

list(eta = eta, alpha = alpha, tau = tau) |>
  saveRDS(glue("posterior/{side}/{year}.rds"))
